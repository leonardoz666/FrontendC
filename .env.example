# Frontend (Next.js) — variáveis de ambiente
#
# Copie para `.env.local` (desenvolvimento) e preencha os valores.
# ATENÇÃO: o `.gitignore` do projeto ignora `.env*`, inclusive este arquivo.
# Nenhum segredo real deve ser escrito aqui — apenas nomes e valores de exemplo.

# Chave local usada para proteger o vínculo entre esta instalação e a API.
# Gere um valor aleatório com pelo menos 32 caracteres para cada distribuição.
FRONTEND_INSTALLATION_SECRET="dev-installation-secret-change-me-32-chars"

# Endereço central do BackendC. Esta variável é usada somente pelo servidor do
# FrontendC e não é digitada pelos estabelecimentos.
BACKEND_URL="http://localhost:4000"
BACKEND_PROXY_TIMEOUT_MS=10000

# Suporte via WhatsApp exibido como botão flutuante no canto inferior direito.
# Aceita a URL completa (https://wa.me/5571999999999 ou https://chat.whatsapp.com/...)
# ou apenas o telefone, com DDI e DDD (ex.: 5571999999999).
# Se a variável não existir ou estiver vazia, o botão NÃO é renderizado.
NEXT_PUBLIC_SUPORTE_WHATSAPP=""
