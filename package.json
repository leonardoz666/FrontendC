{
  "name": "controlae-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:ci": "npm run test:payment && npm run test:product-catalog && npm run test:product-form && npm run test:flavor-size-pricing && npm run test:table-transfer && npm run test:category-printer && npm run test:data-sync && npm run test:offline && npm run test:menu-json-import && npm run test:printer-agent-config && npm run test:api && npm run test:auth-session-cache && npm run test:stock-lot-contrast && npm run test:no-native-confirms && npm run test:tenant-branding && npm run test:multi-tenant-installation",
    "test:payment": "node scripts/verify-payment.cjs",
    "test:product-catalog": "node scripts/verify-product-catalog.cjs",
    "test:product-form": "node scripts/verify-product-form.cjs",
    "test:flavor-size-pricing": "ts-node --project scripts/tsconfig.json scripts/verify-flavor-size-pricing.ts",
    "test:table-transfer": "ts-node --project scripts/tsconfig.json scripts/verify-table-transfer.ts",
    "test:category-printer": "node scripts/verify-category-printer.cjs",
    "test:data-sync": "node scripts/verify-data-sync.cjs",
    "test:offline": "node scripts/verify-offline.cjs",
    "test:menu-json-import": "ts-node --project scripts/tsconfig.json scripts/verify-menu-json-import.ts",
    "test:printer-agent-config": "ts-node --project scripts/tsconfig.json scripts/verify-printer-agent-config.ts",
    "test:printer-destination": "ts-node --project scripts/tsconfig.json scripts/verify-printer-destination.ts",
    "test:api": "node scripts/verify-api.cjs",
    "test:stock-lot-contrast": "node scripts/verify-stock-lot-contrast.cjs",
    "test:no-native-confirms": "node scripts/verify-no-native-confirms.cjs",
    "dev": "node --disable-warning=DEP0060 node_modules/next/dist/bin/next dev",
    "build": "npm run typecheck && node --disable-warning=DEP0060 node_modules/next/dist/bin/next build",
    "test:tenant-branding": "node scripts/verify-tenant-branding-isolation.cjs",
    "test:multi-tenant-installation": "ts-node --project scripts/tsconfig.json scripts/verify-multi-tenant-installation.ts",
    "test:auth-session-cache": "ts-node --project scripts/tsconfig.json scripts/verify-auth-session-cache.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=DEP0060 node_modules/next/dist/bin/next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@serwist/next": "9.5.13",
    "@tanstack/react-query": "^5.90.16",
    "@types/node-fetch": "^2.6.13",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "next": "15.5.28",
    "node-fetch": "^2.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "fake-indexeddb": "^6.2.5",
    "serwist": "9.5.13",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "braces": "https://github.com/Im-Fran/braces/archive/cd87537a878642097328be419a7cb94e7e2d8b95.tar.gz",
    "postcss": "^8.5.23"
  }
}
